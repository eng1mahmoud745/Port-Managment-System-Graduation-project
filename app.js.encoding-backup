        if (isApiRequest) {
            return res.status(401).json({ success: false, message: 'ط§ظ†طھظ‡طھ ط§ظ„ط¬ظ„ط³ط©طŒ ظٹط±ط¬ظ‰ طھط³ط¬ظٹظ„ ط§ظ„ط¯ط®ظˆظ„ ظ…ظ† ط¬ط¯ظٹط¯.' });
