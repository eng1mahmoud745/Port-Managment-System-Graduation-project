    }

    // 1. ط§ط³طھط®ط±ط§ط¬ ط§ظ„ط¨ظٹط§ظ†ط§طھ ط§ظ„ط­ط§ظ„ظٹط© ظ„ظ„ظ…ط§ط¯ط© ظ„ظ„طھط­ظ‚ظ‚ ظ…ظ† ط§ظ„طµظˆط± ط§ظ„ظ‚ط¯ظٹظ…ط©
    const getCurrentDataSql = 'SELECT images FROM inventory_items WHERE item_id = ?';
    
    db.query(getCurrentDataSql, [itemId], (err, currentResults) => {
        if (err) {
            console.error('Database error on fetching current item data:', err);
            return res.status(500).json({ success: false, message: 'ظپط´ظ„ ظپظٹ ط¬ظ„ط¨ ط¨ظٹط§ظ†ط§طھ ط§ظ„ظ…ط§ط¯ط© ط§ظ„ط­ط§ظ„ظٹط©.' });
        }
        
        if (currentResults.length === 0) {
            return res.status(404).json({ success: false, message: 'ط§ظ„ظ…ط§ط¯ط© ط؛ظٹط± ظ…ظˆط¬ظˆط¯ط©.' });
        }
        
        const currentItem = currentResults[0];
        let existingImages = [];
        
        // ظ…ط­ط§ظˆظ„ط© طھط­ظ„ظٹظ„ ط§ظ„طµظˆط± ط§ظ„ظ‚ط¯ظٹظ…ط©
        try {
            if (currentItem.images) {
                existingImages = JSON.parse(currentItem.images);
            }
        } catch (e) {
            console.warn('Could not parse existing images JSON:', currentItem.images);
            // ظ‚ط¯ ظ†ط­طھط§ط¬ ظ„ظ…ط¹ط§ظ„ط¬ط© ط§ظ„طµظˆط± ط§ظ„ظ‚ط¯ظٹظ…ط© ظپظٹ ط§ظ„ظˆط§ط¬ظ‡ط© ط§ظ„ط£ظ…ط§ظ…ظٹط© ط¥ط°ط§ ظƒط§ظ†طھ ظ…ط¹ط·ظˆط¨ط©
        }
        
        // 2. ط¯ظ…ط¬ ط§ظ„طµظˆط± ط§ظ„ط¬ط¯ظٹط¯ط© ظ…ط¹ ط§ظ„ظ‚ط¯ظٹظ…ط©
        let finalImages = existingImages;
        if (new_images) {
            try {
                const newImagesArray = JSON.parse(new_images);
                // ظٹطھظ… ط§ط³طھط¨ط¯ط§ظ„ ط§ظ„ظ‚ط§ط¦ظ…ط© ط¨ط§ظ„ط¬ط¯ظٹط¯ط© ظپظٹ ظ‡ط°ط§ ط§ظ„ط³ظٹظ†ط§ط±ظٹظˆ ظ„طھط¨ط³ظٹط· ط§ظ„ط¹ظ…ظ„ظٹط©
                // ظپظٹ ط§ظ„طھط·ط¨ظٹظ‚ط§طھ ط§ظ„ط­ظ‚ظٹظ‚ظٹط©: ظٹطھظ… ط¯ظ…ط¬ ط£ظˆ طھط­ط¯ظٹط¯ ط§ظ„طµظˆط± ط§ظ„طھظٹ طھط¨ظ‚ظ‰
                finalImages = newImagesArray; 
            } catch (e) {
                return res.status(400).json({ success: false, message: 'طµظٹط؛ط© JSON ظ„ظ…ط³ط§ط±ط§طھ ط§ظ„طµظˆط± ط§ظ„ط¬ط¯ظٹط¯ط© ط؛ظٹط± طµط§ظ„ط­ط©.' });
            }
        }
        
        const finalImagesJson = finalImages.length > 0 ? JSON.stringify(finalImages) : null;

        // 3. ط¨ظ†ط§ط، ط¬ظ…ظ„ط© ط§ظ„طھط­ط¯ظٹط«
        const updateSql = `
            UPDATE inventory_items
            SET 
                item_code = COALESCE(?, item_code),
                item_name = COALESCE(?, item_name),
                min_stock = COALESCE(?, min_stock),
                unit = COALESCE(?, unit),
                location_id = ?,
                images = ?
            WHERE item_id = ?;
        `;

        const values = [
            code,
            name,
            min_stock,
            unit,
            location_id || null, // ظٹظ…ظƒظ† ط£ظ† ظٹظƒظˆظ† NULL
            finalImagesJson,
            itemId
        ];

        // 4. طھظ†ظپظٹط° ط§ظ„طھط­ط¯ظٹط«
        db.query(updateSql, values, (err, result) => {
            if (err) {
                console.error('Database error during item update:', err);
                return res.status(500).json({ success: false, message: 'ظپط´ظ„ ظپظٹ طھط­ط¯ظٹط« ط¨ظٹط§ظ†ط§طھ ط§ظ„ظ…ط§ط¯ط©.' });
            }

            if (result.affectedRows === 0) {
                return res.status(404).json({ success: false, message: 'ط§ظ„ظ…ط§ط¯ط© ط؛ظٹط± ظ…ظˆط¬ظˆط¯ط© ط£ظˆ ظ„ظ… طھطھط؛ظٹط± ط§ظ„ط¨ظٹط§ظ†ط§طھ.' });
            }

            res.json({ success: true, message: 'طھظ… طھط­ط¯ظٹط« ط¨ظٹط§ظ†ط§طھ ط§ظ„ظ…ط§ط¯ط© ط¨ظ†ط¬ط§ط­.' });
        });
    });
});
