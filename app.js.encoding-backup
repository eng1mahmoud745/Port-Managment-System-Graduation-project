app.get('/api/locations', (req, res) => {
    // 1. ط§ط³طھط®ط±ط§ط¬ ظ…ط¹ظ„ظ…ط§طھ ط§ظ„ط§ط³طھط¹ظ„ط§ظ… (Query Parameters)
    const { search, warehouseId, status } = req.query;
   
    // 2. ط¨ظ†ط§ط، ط§ط³طھط¹ظ„ط§ظ… SQL ط£ط³ط§ط³ظٹ ظ…ط¹ ط§ظ„ط±ط¨ط· ط¨ط¬ط¯ظˆظ„ warehouses
    let query = `
        SELECT 
            l.id, l.code, l.rack, l.aisle, l.level, l.capacity, l.status,
            l.warehouse_id, 
            w.name AS warehouse_name, 
            w.code AS warehouse_code
        FROM locations l
        JOIN warehouses w ON l.warehouse_id = w.id
        WHERE 1=1
    `;
    const params = [];

    // 3. طھط·ط¨ظٹظ‚ ط´ط±ظˆط· ط§ظ„طھطµظپظٹط© ط¯ظٹظ†ط§ظ…ظٹظƒظٹط§ظ‹
    
    // ط§ظ„طھطµظپظٹط© ط¨ظ…ط¹ط±ظپ ط§ظ„ظ…ط³طھظˆط¯ط¹
    if (warehouseId) {
        query += ` AND l.warehouse_id = ?`;
        params.push(warehouseId);
    }

    // ط§ظ„طھطµظپظٹط© ط¨ط§ظ„ط­ط§ظ„ط©
    if (status) {
        query += ` AND l.status = ?`;
        params.push(status);
    }
    
    // ط§ظ„ط¨ط­ط« ط¨ط±ظ…ط² ط§ظ„ظ…ظˆظ‚ط¹ ط£ظˆ ط§ظ„ط±ظپ ط£ظˆ ط§ظ„ظ…ظ…ط± ط£ظˆ ط§ظ„ظ…ط³طھظˆظ‰
    if (search) {
        query += ` AND (l.code LIKE ? OR l.rack LIKE ? OR l.aisle LIKE ? OR l.level LIKE ?)`;
        const searchTerm = `%${search}%`;
        params.push(searchTerm, searchTerm, searchTerm, searchTerm);
    }

    // ط§ظ„طھط±طھظٹط¨ ط§ظ„ط§ظپطھط±ط§ط¶ظٹ
    query += ` ORDER BY l.code ASC;`;

    // 4. طھظ†ظپظٹط° ط§ظ„ط§ط³طھط¹ظ„ط§ظ… 
    db.query(query, params, (err, results) => {
        if (err) {
            console.error('Error fetching locations:', err);
            return res.status(500).json({ 
                success: false, 
                message: 'ظپط´ظ„ ط¬ظ„ط¨ ظ‚ط§ط¦ظ…ط© ط§ظ„ظ…ظˆط§ظ‚ط¹ ظ…ظ† ظ‚ط§ط¹ط¯ط© ط§ظ„ط¨ظٹط§ظ†ط§طھ.' 
            });
        }
      
        // 5. ط¥ط±ط³ط§ظ„ ط§ظ„ط¨ظٹط§ظ†ط§طھ
        res.status(200).json({ 
            success: true, 
            locations: results // ط¥ط±ط¬ط§ط¹ ظ…طµظپظˆظپط© ط§ظ„ظ…ظˆط§ظ‚ط¹
