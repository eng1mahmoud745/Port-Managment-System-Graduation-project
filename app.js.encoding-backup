// GET /api/inventory/transactions/:id - ط¬ظ„ط¨ طھظپط§طµظٹظ„ ط­ط±ظƒط© ظˆط§ط­ط¯ط©
app.get('/api/inventory/transactions/:id', (req, res) => {
    const transactionId = req.params.id;

    // ط§ط³طھط¹ظ„ط§ظ… ظ„ط¬ظ„ط¨ طھظپط§طµظٹظ„ ط§ظ„ط­ط±ظƒط© ظ…ط¹ ط§ط³ظ… ظˆظƒظˆط¯ ظˆظˆط­ط¯ط© ط§ظ„ظ…ط§ط¯ط©
    const sql = `
        SELECT 
            t.transaction_id AS id, 
            t.type, 
            t.qty_change AS qty, 
            t.reference, 
            t.user, 
            t.created_at AS date, 
            t.attachment_paths,
            i.item_name,
            i.item_code,
            i.unit
        FROM transaction_log t
        JOIN inventory_items i ON t.item_id = i.item_id
        WHERE t.transaction_id = ?;
    `;

    db.query(sql, [transactionId], (err, results) => {
        if (err) {
            console.error('Database error fetching transaction details:', err);
            return res.status(500).json({ success: false, message: 'ظپط´ظ„ ظپظٹ ط¬ظ„ط¨ طھظپط§طµظٹظ„ ط§ظ„ط­ط±ظƒط©.' });
